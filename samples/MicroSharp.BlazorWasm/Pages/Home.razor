@page "/"
@inject IJSRuntime Js
@using MicroSharp
@using MicroSharp.Browser
@using MicroSharp.Processing

<PageTitle>MicroSharp</PageTitle>

<h1>Mikrofon</h1>

<p id="mic-flags">Browser-Host: @_requiresBrowser, Systemgeraet: @_capturesDevice, Rate: <span id="mic-rate">@_rateHz</span></p>
<p id="mic-status">@_status</p>
<p>Bloecke: <span id="mic-chunks">@_chunks</span>, letzte Laenge: <span id="mic-bytes">@_lastBytes</span>, Spitze: <span id="mic-peak">@_peak</span></p>
<p>Dauer: <span id="mic-duration">@_durationMs</span>, mittlere absolute Amplitude: <span id="mic-mean">@_meanAbsolute</span>, Verlauf: <span id="mic-history">@_historyBytes</span></p>

<button id="mic-start" @onclick="StartAsync">Start</button>
<button id="mic-stop" @onclick="StopAsync">Stopp</button>
<button id="mic-release" @onclick="ReleaseAsync">Freigabe</button>

@code {
    private readonly BrowserCaptureControllerOptions _options = new()
    {
        Format = new PcmFormat(16_000, TimeSpan.FromMilliseconds(20)),
    };

    private BrowserCaptureController? _controller;
    private BrowserCaptureLease? _lease;
    private int _rateHz = 16_000;
    private bool _requiresBrowser;
    private bool _capturesDevice;
    private int _chunks;
    private int _lastBytes;
    private int _peak;
    private string _durationMs = "0";
    private int _meanAbsolute;
    private long _historyBytes;
    private PcmHistoryRing? _history;
    private PcmHistoryCursor _cursor;
    private string _status = "idle";

    private async Task StartAsync()
    {
        await ReleaseAsync();
        _chunks = 0;
        _lastBytes = 0;
        _peak = 0;
        _durationMs = "0";
        _meanAbsolute = 0;
        _historyBytes = 0;
        _history = null;
        var flags = new BrowserMicrophoneCapture(Js);
        _requiresBrowser = flags.RequiresBrowserHost;
        _capturesDevice = flags.CapturesOperatingSystemDevice;
        _rateHz = _options.Format.SampleRateHz;
        _controller = new BrowserCaptureController(Js, _options);
        try
        {
            _lease = await _controller.StartAsync(_options.Format);
            _history = new PcmHistoryRing(_options.Format, TimeSpan.FromSeconds(1));
            _cursor = _history.OpenCursor(PcmHistoryCursorOrigin.Latest);
            _status = "running";
            _ = ReadAsync(_lease);
        }
        catch (Exception exception)
        {
            _status = exception.Message;
        }
    }

    private async Task ReadAsync(BrowserCaptureLease lease)
    {
        try
        {
            await foreach (var payload in lease.ReadPayloadsAsync())
            {
                _chunks++;
                _lastBytes = payload.Length;
                _peak = Math.Max(_peak, Peak(payload));
                if (_history is not null)
                {
                    _history.Write(payload);
                    var copy = _history.ReadRightSized(ref _cursor, payload.Length);
                    if (copy is not null)
                    {
                        var analysis = Pcm16LeBlockAnalyzer.Analyze(copy, _options.Format);
                        _durationMs = analysis.DurationMilliseconds.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
                        _meanAbsolute = analysis.MeanAbsoluteAmplitude;
                        _historyBytes = copy.Length;
                    }
                }

                await InvokeAsync(StateHasChanged);
            }

            if (_status == "running")
            {
                _status = "stopped";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception exception)
        {
            _status = exception.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopAsync()
    {
        if (_controller is not null)
        {
            await _controller.StopAsync();
            _status = "stopped";
        }
    }

    private async Task ReleaseAsync()
    {
        if (_lease is not null)
        {
            await _lease.DisposeAsync();
            _lease = null;
        }

        if (_controller is not null)
        {
            await _controller.ReleaseAsync();
            _controller = null;
            _status = "released";
        }
    }

    private static int Peak(byte[] payload)
    {
        var peak = 0;
        var samples = PcmEncoding.ToSamples(payload);
        foreach (var sample in samples)
        {
            var magnitude = sample == short.MinValue ? 32768 : Math.Abs(sample);
            if (magnitude > peak)
            {
                peak = magnitude;
            }
        }

        return peak;
    }
}
