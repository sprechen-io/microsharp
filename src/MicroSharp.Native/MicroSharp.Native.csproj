<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>MicroSharp.Native</RootNamespace>
    <AssemblyName>MicroSharp.Native</AssemblyName>
    <Description>Microphone capture for ordinary .NET. OpenAlMicrophoneCapture opens a named OpenAL 1.1 capture device through OpenTK.Audio.OpenAL. VirtualMicrophoneCapture supplies in-process PCM and does not open a device. Linux and Windows CI load OpenAL and reject an explicit invalid device name. That is not a physical recording. macOS is not a supported claim. The native library is not included.</Description>
    <PackageTags>microphone;audio;pcm;openal</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroSharp\MicroSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.Audio.OpenAL" Version="4.9.4" />
  </ItemGroup>
</Project>
